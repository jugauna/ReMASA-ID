# ReMASA ID - variables de entorno (plantilla)
# Copiar a .env y completar secretos reales antes de levantar en produccion.
# Repositorio: https://github.com/jugauna/ReMASA-ID.git

# ---------------------------------------------------------------------------
# Credenciales Google OAuth2
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_PROXY_COOKIE_SECRET=base64-32-byte-secret
# URL de callback OAuth2: fijada en docker-compose.yml como
# https://login.remasa.com/oauth2/callback (debe coincidir con Google Cloud Console).

# Django (remasa-id-admin)
DJANGO_SECRET_KEY=cambiar-por-clave-larga-y-aleatoria

# ---------------------------------------------------------------------------
# Configuracion de red
# ---------------------------------------------------------------------------
IP_VPS=67.207.83.113
IP_HOSTINGER=89.117.7.185

# ---------------------------------------------------------------------------
# Dominios
# ---------------------------------------------------------------------------
DOMAIN_ROOT=remasa.com
SUBDOMAIN_LOGIN=login.remasa.com
SUBDOMAIN_INTRANET=intranet.remasa.com
SUBDOMAIN_INVOICE=invoice.remasa.com
SUBDOMAIN_PYG=pyg.remasa.com
SUBDOMAIN_ADMIN=admin.remasa.com

# ---------------------------------------------------------------------------
# Puertos de aplicaciones y observabilidad
# ---------------------------------------------------------------------------
PORT_INVOICE_APP=8000
PORT_PYG_APP=8001
PORT_LOGS=8888
